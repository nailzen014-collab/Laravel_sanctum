                                                                                    "pm.collectionVariables.set(\u0027test_email\u0027, \u0027siswa\u0027 + Date.now() + \u0027@gmail.com\u0027);"
                                                                                ]
                                                                   }
                                                    },
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "type":  "text/javascript",
                                                                       "exec":  [
                                                                                    "pm.test(\u0027Status 201 Created\u0027, () =\u003e pm.response.to.have.status(201));",
                                                                                    "const body = pm.response.json();",
                                                                                    "pm.test(\u0027status bernilai true\u0027, () =\u003e pm.expect(body.status).to.eql(true));",
                                                                                    "pm.test(\u0027token tersedia\u0027, () =\u003e pm.expect(body.data.token).to.be.a(\u0027string\u0027).and.not.empty);",
                                                                                    "pm.test(\u0027nama sesuai\u0027, () =\u003e pm.expect(body.data.name).to.eql(\u0027Siswa LKPD\u0027));",
                                                                                    "pm.collectionVariables.set(\u0027token\u0027, body.data.token);"
                                                                                ]
                                                                   }
                                                    }
                                                ],
